{
  "extends": "./tsconfig.json",
  // The package ships dist/ only, so maps pointing back at src/ would dangle.
  "compilerOptions": {
    "sourceMap": false,
    "declarationMap": false
  },
  // test-realm.ts and test-pool.ts create throwaway Keycloak realms and Cognito pools for the tests
  "exclude": ["src/**/*.test.ts", "src/keycloak/test-realm.ts", "src/cognito/test-pool.ts"]
}
