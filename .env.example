# Optional. Without these, npm test starts a throwaway Keycloak in Docker and removes it afterwards.
# Set them to run the tests against a Keycloak you already run (each test still creates and deletes its own realm).
# KEYCLOAK_TEST_URL=http://localhost:8180
# KEYCLOAK_TEST_ADMIN_USER=admin
# KEYCLOAK_TEST_ADMIN_PASSWORD=admin
